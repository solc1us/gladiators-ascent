@base = http://localhost:3000
# Set this to an actual ID from GET all (Marcus is 11 only on a fresh seeded DB).
@existingId = 11

### Get all (IDs persist and sequences do not restart with NestJS)
GET {{base}}/gladiators

### Get an existing record using an ID returned above
GET {{base}}/gladiators/{{existingId}}

### Create a temporary record; subsequent requests use its returned ID
# @name createGladiator
POST {{base}}/gladiators
Content-Type: application/json

{"name":"Aelius-{{$guid}}","style":"Agile"}

### Update only the supplied field on the created record
PATCH {{base}}/gladiators/{{createGladiator.response.body.$.id}}
Content-Type: application/json

{"style":"Heavy"}

### Restart NestJS before this request to verify persistence
GET {{base}}/gladiators/{{createGladiator.response.body.$.id}}

### Delete only the temporary record created above (returns deleted record)
DELETE {{base}}/gladiators/{{createGladiator.response.body.$.id}}

### Invalid DTO: 400
POST {{base}}/gladiators
Content-Type: application/json

{"name":"AB","style":"Unknown","kills":-1}

### Missing gladiator: 404 (the temporary record must have been deleted)
GET {{base}}/gladiators/{{createGladiator.response.body.$.id}}

### Duplicate name: 409 (requires the Maximus seed record)
POST {{base}}/gladiators
Content-Type: application/json

{"name":"  MAXIMUS  ","style":"Balanced"}
