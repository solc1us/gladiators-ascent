generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Gladiator {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  style    String
  kills    Int     @default(0)
  status   String  @default("Alive")
  isPlayer Boolean @default(true)
}
